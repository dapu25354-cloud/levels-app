# 複製這個檔案成 .streamlit/secrets.toml（已在 .gitignore 排除，不會上傳）
# 本機測試 streamlit run app.py 用；正式部署的密鑰貼在 Streamlit Cloud 後台的 Secrets 設定，不是這個檔案。

APP_PW = "設一個你自己的登入密碼"

# 可選備援：填入 scripts/positions_schema.example.json 的同格式 JSON 字串。
# 若同時設定 GH_TOKEN/GIST_ID，網頁會優先讀 Gist；只有 Gist 讀取失敗時才使用這份舊資料。
# 日常更新請在本機修改 positions_local.json，再執行：python scripts/sync_positions.py
POSITIONS_JSON = '{"EXAMPLE.TW":{"default":{"cost":0,"shares":0}},"_trade_log":[]}'

# 私有 Gist：網頁讀取與本機同步都使用這兩個設定。
# 請只把真值填到本機 .streamlit/secrets.toml 或 Streamlit Cloud Secrets，
# 不要把真實 token、Gist ID 或持倉寫入這個範例檔。
GH_TOKEN = "跑完 setup_github.py 後拿到的 GitHub token"
GIST_ID = "跑完 setup_github.py 後印出來的 Gist ID"
