# 複製這個檔案成 .streamlit/secrets.toml（已在 .gitignore 排除，不會上傳）
# 本機測試 streamlit run app.py 用；正式部署的密鑰貼在 Streamlit Cloud 後台的 Secrets 設定，不是這個檔案。

APP_PW = "設一個你自己的登入密碼"

# Streamlit Cloud 部署用：填入 scripts/positions_schema.example.json 的同格式 JSON 字串。
# 這是唯讀 Secret；App 內的交易編輯若要永久保存，請繼續使用下方的私有 Gist 設定。
POSITIONS_JSON = '{"EXAMPLE.TW":{"default":{"cost":0,"shares":0}},"_trade_log":[]}'

# 舊版私有 GitHub Gist 部署方式（若同時設定，POSITIONS_JSON 優先）
GH_TOKEN = "跑完 setup_github.py 後拿到的 GitHub token"
GIST_ID = "跑完 setup_github.py 後印出來的 Gist ID"
